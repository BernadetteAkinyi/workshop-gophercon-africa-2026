package pages

import (
	"strconv"
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Gallery(sightings []sighting.Sighting) {
	{{ photos := components.PhotoItems(sightings, 0) }}
	@layout.Base(layout.BaseProps{
		Title:       "Gallery",
		Description: "Every photo shared with a sighting of African wildlife.",
		Page:        "gallery",
	}) {
		<header class="page-head">
			<p class="eyebrow">Gallery</p>
			<h1>The photo wall</h1>
			<p class="page-head__lede">{ strconv.Itoa(len(photos)) } photos shared with the sightings. Click one to see it big.</p>
		</header>
		if len(photos) == 0 {
			<p class="empty">No photos yet.</p>
		} else {
			@components.Filter(components.FilterProps{
				Target: "photos",
				Groups: []components.FilterGroup{
					{Key: "animal", Label: "Animal", Options: components.FilterOptions(sightings, 14, components.Animal)},
				},
			})
			@components.PhotoWall(sightings, 0, true)
		}
	}
}
