package pages

import (
	"strconv"
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

// tickerNames are the featured animals, repeated across the strip between the
// banner and the map. Decorative only: the same animals appear in full below.
var tickerNames = []string{
	"Lion", "Leopard", "Elephant", "Rhinoceros", "African buffalo",
	"Giraffe", "Zebra", "Hippopotamus", "Cheetah",
}

templ Home(sightings []sighting.Sighting) {
	{{ sum := sighting.Summarise(sightings) }}
	{{ byYear := sighting.CountByYear(sightings) }}
	{{ tiles := components.AnimalTiles(sightings) }}
	{{ hero, hasHero := components.HeroPhoto(sightings) }}
	@layout.Base(layout.BaseProps{
		Title:       "Africa’s wildlife, one sighting at a time",
		Description: "A celebration of Africa's wildlife: real sightings on a map and a globe, with photos and the weather on the day each animal was seen.",
		Page:        "home",
		Map:         true,
		Globe:       len(sightings) > 0,
	}) {
		<section class="hero">
			if hasHero {
				<img class="hero__image" src={ hero.Photo.URL } alt="" fetchpriority="high"/>
			}
			<div class="hero__inner">
				<p class="eyebrow eyebrow--light">Wildlife sightings across Africa</p>
				<h1 class="hero__title">Every sighting tells a story of the wild</h1>
				if len(sightings) == 0 {
					<p class="hero__lede">No sightings have been ingested yet.</p>
				} else {
					<p class="hero__lede">
						Real records of lions, elephants, shoebills and more, shared by people in the field.
						Each one placed on the map, with its photos and the weather on the day it was seen.
					</p>
					<p class="hero__actions">
						<a class="button" href="#idea">Discover the idea</a>
						<a class="button button--light" href="#sightings">See the sightings</a>
					</p>
				}
			</div>
			if hasHero {
				<p class="hero__credit">
					<a href={ templ.SafeURL(components.SightingURL(hero.Sighting)) }>{ components.DisplayName(hero.Sighting) }, { hero.Sighting.Location.Country }</a>
					if hero.Photo.Creator != "" {
						· Photo: { hero.Photo.Creator }
					}
				</p>
			}
		</section>
		if len(sightings) > 0 {
			<div class="ticker" aria-hidden="true">
				<div class="ticker__track">
					for rep := 0; rep < 2; rep++ {
						<div class="ticker__group">
							for i := 0; i < 3; i++ {
								for _, name := range tickerNames {
									<span class="ticker__item">{ name }</span>
								}
							}
						</div>
					}
				</div>
			</div>
			<section id="sightings" class="section reveal" aria-labelledby="sightings-title">
				<div class="section__head">
					<div>
						<p class="eyebrow">The map</p>
						<h2 id="sightings-title">Where they were seen</h2>
					</div>
					<p>Every sighting, plotted. Zoom in and the groups split apart; click a dot to open that record. The full list sits underneath.</p>
				</div>
				@components.Map(components.MapProps{
					Points:  components.MapPoints(sightings),
					Cluster: true,
					Label:   "Map of every sighting, grouped by area",
				})
				@components.Filter(components.FilterProps{
					Target: "sightings-list",
					Search: true,
					Groups: []components.FilterGroup{
						{Key: "animal", Label: "Animal", Options: components.FilterOptions(sightings, 12, components.Animal)},
						{Key: "country", Label: "Country", Options: components.FilterOptions(sightings, 10, components.Country)},
					},
				})
				@components.SightingList(sightings, "sightings-list")
			</section>
			<section id="idea" class="section reveal" aria-labelledby="idea-title">
				<div class="section__intro">
					<p class="eyebrow">The idea</p>
					<h2 id="idea-title">A window onto the wild, built from real moments</h2>
					<p>
						Somewhere, someone stops, raises a camera and records what they see. This site gathers
						those moments for Africa’s wildlife, so you can see where each animal lives, when it was seen
						and what the day was like.
					</p>
				</div>
				<ol class="steps">
					<li class="step">
						<svg class="step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
						<h3>Seen in the field</h3>
						<p>Every record comes from a person who saw the animal, shared openly through GBIF, the global biodiversity network.</p>
					</li>
					<li class="step">
						<svg class="step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>
						<h3>With the weather that day</h3>
						<p>We look up the conditions at that spot on that day: the temperature, the sky, the wind and the rain.</p>
					</li>
					<li class="step">
						<svg class="step__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
						<h3>Placed on the map</h3>
						<p>Each sighting becomes a point on the globe and the map, and gets a page of its own with its photos.</p>
					</li>
				</ol>
			</section>
			<section class="band reveal" aria-labelledby="numbers-title">
				<div class="container band__inner">
					<h2 id="numbers-title" class="visually-hidden">In numbers</h2>
					<dl class="numbers">
						<div><dt>sightings</dt><dd>{ strconv.Itoa(sum.Sightings) }</dd></div>
						<div><dt>kinds of animal</dt><dd>{ strconv.Itoa(len(tiles)) }</dd></div>
						<div><dt>countries</dt><dd>{ strconv.Itoa(sum.Countries) }</dd></div>
						<div><dt>photos</dt><dd>{ strconv.Itoa(sum.Media) }</dd></div>
					</dl>
					<div class="band__chart">
						<p>Sightings per year, { strconv.Itoa(sum.Earliest.Year()) }–{ strconv.Itoa(sum.Latest.Year()) }</p>
						@components.Sparkline(byYear, sum)
						<a class="band__link" href="/stats">Explore the statistics →</a>
					</div>
				</div>
			</section>
			<section id="animals" class="section reveal" aria-labelledby="animals-title">
				<div class="section__head">
					<div>
						<p class="eyebrow">Meet the animals</p>
						<h2 id="animals-title">Who we’ve seen</h2>
					</div>
					<p>The Big Five and the classics of the safari. Each animal has a page of its own, with its map and its photos.</p>
				</div>
				@components.AnimalWall(tiles)
			</section>
			<section class="section globe-section reveal" aria-labelledby="globe-title">
				<div class="globe-section__text">
					<p class="eyebrow">One planet</p>
					<h2 id="globe-title">Every dot is a moment someone shared</h2>
					<p>
						Turn the globe to see where the sightings are. Most are in Africa, and a few are of the same animals
						far from home, such as flamingos on Europe’s coasts.
					</p>
					<a class="button button--outline" href="#sightings">Zoom in on the map</a>
				</div>
				<div class="globe-section__globe">
					@components.Globe(components.GlobePoints(sightings))
				</div>
			</section>
			if len(components.PhotoItems(sightings, 1)) > 0 {
				<section class="section reveal" aria-labelledby="photos-title">
					<div class="section__head">
						<div>
							<p class="eyebrow">Gallery</p>
							<h2 id="photos-title">Through their lenses</h2>
						</div>
						<p><a class="button button--outline" href="/gallery">See every photo</a></p>
					</div>
					@components.PhotoWall(sightings, 8, false)
				</section>
			}
			<section class="section closing reveal" aria-labelledby="closing-title">
				<h2 id="closing-title">The wild needs more eyes</h2>
				<p>Every record helps scientists understand where animals live and how they’re doing. If you see wildlife, share it.</p>
				<p class="hero__actions">
					<a class="button" href="https://www.inaturalist.org" rel="noopener">Record a sighting on iNaturalist</a>
					<a class="button button--light" href="https://www.gbif.org" rel="noopener">Explore GBIF</a>
				</p>
			</section>
		}
	}
}
